# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 运行配置（含本地会话密钥与 OneDrive 备份路径，不进仓库）──
zhicai/config.yaml

# ── 业务数据（含真实客户/账务数据，绝不进版本历史）──
*.db
*.sqlite
*.sqlite3
backups/
# 运行时数据目录（含 zhicai.db 与客户发票影像等附件）；本地恢复请用便携包
zhicai/data/

# ── 运行时产物 ──
server*.log
*.tmp
*.url
Thumbs.db

# ── 便携包产物（二进制，非源码）──
*.zip

# ── 测试/性能产物 ──
.coverage
data/perf.db

# ── WorkBuddy 工作记忆（与代码无关）──
.workbuddy/

# ── 环境变量 ──
.env
.env.*
!.env.example
